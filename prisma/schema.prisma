generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//valores predefinidos
enum Role {
    USER
    ADMIN
    EDITOR
}

enum PostStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
}

model User {
    id        Int       @id @default(autoincrement())
    email     String    @unique
    name      String
    role      Role      @default(USER) //asignar un valor predefinido
    password  String
    createdAt DateTime  @default(now())
    posts     Post[] //un usuario puede tener uno o mas posts
    profile   Profile? //un usuario tiene o no un solo perfil
    comments  Comment[] //un usuario puede hacer varios comentarios
}

model Product {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    price     Float
    inStock   Boolean  @default(true)
    createdAt DateTime @default(now())
    metadata  Json?
}

model Profile {
    id        Int     @id @default(autoincrement())
    bio       String?
    avatarUrl String?
    userId    Int     @unique
    user      User    @relation(fields: [userId], references: [id]) //un perfil pertenece a un solo usuario
}

model Post {
    id        Int        @id @default(autoincrement())
    title     String
    published PostStatus @default(DRAFT)
    authorId  Int
    author    User       @relation(fields: [authorId], references: [id]) //un post solo pertenece a un usuario
    category  Category[] //un post puede tener varias categorias
    comments  Comment[] //un post puede tener varios comentarios
}

model Category {
    id    Int    @id @default(autoincrement())
    name  String @unique
    post Post[] //una categoria pertenece a mas de un post
}

model Comment {
    id      Int    @id @default(autoincrement())
    content String
    postId  Int
    userId  Int
    post    Post   @relation(fields: [postId], references: [id]) //ese post pertenece aun solo comentario
    user    User   @relation(fields: [userId], references: [id]) //ese comentario pertenece aun solo usuario
}
